---
import Base from "../layouts/Base.astro";
---

<Base title="Página não encontrada | Tapetê" description="Esta página não existe.">
  <main class="hero" style="min-height: 100vh; display: grid; place-items: center; padding: 48px 0;">
    <div class="container hero-conteudo">
      <img class="hero-logo" src="/logo.png" alt="Tapetê – Lavanderia Profissional" width="320" height="160" />
      <h1>Página não encontrada</h1>
      <p class="hero-sub">O endereço que você abriu não existe ou mudou de lugar.</p>
      <a href="/" class="botao botao-agua">Voltar para o início</a>
    </div>
  </main>
</Base>
