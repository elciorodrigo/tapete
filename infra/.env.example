# Copie para .env. Na VPS, troque só POSTGRES_PASSWORD.

# Rede do Nginx Proxy Manager nesta VPS (docker network ls)
PROXY_NETWORK=nginx-proxy_default

# Vazio: painel, Flow e webhook ficam em tapete.solucoesdigitais.io
API_PUBLIC_URL=
WEB_ORIGINS=https://tapete.solucoesdigitais.io

# Número do WhatsApp para os botões do site (só dígitos, com DDI). Vazio = botões levam à seção de orçamento
WHATSAPP_NUMERO=

# PostgreSQL (só na rede interna, sem porta publicada)
POSTGRES_USER=tapete
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=tapete

# Pasta no disco da VPS onde o PostgreSQL grava os dados (relativa a infra/ ou caminho absoluto)
POSTGRES_DATA_DIR=./data/postgres

PORT=3000
FLOW_MODE=draft
FLOW_PRIVATE_KEY_PATH=/app/keys/flow_private.pem

# Preenchidos quando for enviar mensagem e ligar o webhook. O ping do Flow não precisa disso.
# META_APP_SECRET=
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_WABA_ID=
# META_FLOW_ID=
# META_WEBHOOK_VERIFY_TOKEN=
# FLOW_PRIVATE_KEY_PASSPHRASE=
